# Epstein Investigation Platform - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up.
# DO NOT commit .env to version control.

# ===================
# PostgreSQL
# ===================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ===================
# Qdrant Vector Database
# ===================
QDRANT_API_KEY=

# ===================
# Neo4j Graph Database
# ===================
NEO4J_USER=
NEO4J_PASSWORD=

# ===================
# AI API Keys
# ===================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ===================
# Cloudflare
# ===================
CLOUDFLARE_TUNNEL_TOKEN=

# ===================
# OpenClaw Gateway
# ===================
OPENCLAW_GATEWAY_TOKEN=

# ===================
# Grafana
# ===================
GRAFANA_PASSWORD=

# ===================
# Cloudflare R2 Storage
# ===================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ===================
# Backend API
# ===================
API_SECRET_KEY=

# ===================
# Hetzner S3 (Object Storage)
# ===================
HETZNER_S3_ENDPOINT=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_BUCKET=
HETZNER_S3_REGION=

# ===================
# Processing Pipeline (docker-compose.processing.yml)
# ===================
WORKER_URL=
